{
  "manifest_version": 3,
  "name": "Omarchy Island – YouTube",
  "version": "1.0.0",
  "description": "Control YouTube playback from Omarchy Island.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ]
    }
  ]
}
