#!/usr/bin/env python3
"""Local activity events for CLI commands and IDE hooks."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import uuid

sys.dont_write_bytecode = True
from activity_events import process_start, runtime


def publish(key, state, label="", pid=0):
    root = runtime()
    target = root / (hashlib.sha256(key.encode()).hexdigest() + ".json")
    if state == "stop":
        target.unlink(missing_ok=True)
        return
    previous = {}
    try:
        previous = json.loads(target.read_text())
    except (OSError, ValueError):
        pass
    now = time.time_ns() // 1_000_000
    new = "startedAt" not in previous or previous.get("state") in ("done", "failed")
    started = now if new else previous["startedAt"]
    if state in ("done", "failed") and new:
        return
    root.mkdir(mode=0o700, exist_ok=True)
    name = (label or previous.get("name") or key)[:60]
    event = {"id": key, "name": name, "state": state, "startedAt": started,
             "doneAt": now if state in ("done", "failed") else 0,
             "updatedAt": now, "pid": pid, "processStart": process_start(pid)}
    with tempfile.NamedTemporaryFile(mode="w", dir=root, delete=False) as handle:
        temporary = Path(handle.name)
        try:
            json.dump(event, handle, ensure_ascii=False)
            handle.flush()
            temporary.replace(target)
        finally:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    for action in ("start", "waiting", "done", "failed", "stop"):
        event = actions.add_parser(action)
        event.add_argument("--pid", type=int, default=0)
        event.add_argument("id")
        event.add_argument("label", nargs="?", default="")
    run = actions.add_parser("run")
    run.add_argument("label")
    run.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.action != "run":
        state = {"start": "thinking", "waiting": "asking"}.get(args.action, args.action)
        publish(args.id, state, args.label, args.pid)
        return 0

    command = args.command
    if not command:
        run.error("a command is required")
    key = "cli:" + uuid.uuid4().hex
    try:
        publish(key, "tool", args.label, os.getpid())
    except OSError as error:
        print(f"island-activity: {error}", file=sys.stderr)
    try:
        code = subprocess.call(command)
    except KeyboardInterrupt:
        code = 130
    except OSError as error:
        print(f"island-activity: {error}", file=sys.stderr)
        code = 127
    try:
        publish(key, "done" if code == 0 else "failed", args.label)
    except OSError as error:
        print(f"island-activity: {error}", file=sys.stderr)
    return code if code >= 0 else 128 - code


if __name__ == "__main__":
    sys.exit(main())
